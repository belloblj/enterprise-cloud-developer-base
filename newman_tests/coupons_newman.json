              "  pm.expect(coupon.coupon_id).to.eql('319326de971100158f6fa0daeec978fba1f17e4b');",
              "  pm.expect(coupon).to.include.keys('title', 'description', 'coupon_code', 'campaign_id', 'provider_id', 'provider_name', 'start_date', 'end_date');",
